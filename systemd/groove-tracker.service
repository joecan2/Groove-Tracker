[Unit]
Description=Groove Tracker — vinyl now-playing display
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=joe
WorkingDirectory=/home/joe/groove-tracker
ExecStart=/home/joe/groove-tracker/venv/bin/python3 -m groove_tracker
Restart=on-failure
RestartSec=10
EnvironmentFile=/home/joe/groove-tracker/.env

[Install]
WantedBy=multi-user.target
