# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real credentials.

# Set to true when developing off the actual Pi (no turntable, no e-paper
# panel attached) — swaps in mock audio/display/collection so the pipeline
# still runs end-to-end. Set to false (or omit) on the real device.
MOCK_MODE=false

# --- AudD (song recognition) --- https://audd.io
AUDD_API_TOKEN=your_audd_api_token_here

# --- Audio capture ---
# Leave AUDIO_DEVICE blank to use the system default input. Run
# `python3 -m sounddevice` on the Pi to list device indices if the USB
# audio adapter isn't picked up automatically.
AUDIO_DEVICE=
SAMPLE_RATE=44100
CHANNELS=2
CLIP_SECONDS=12

# --- DVinyl / MongoDB ---
# Use a dedicated read-only user, not your admin credentials — see
# docs/SETUP.md for how to create one.
#
# Confirmed against a real DVinyl instance: the collection is "albums" (not
# "items"), and there's no "collectionType" field — entry type is "kind"
# (e.g. "Music"). Set MONGO_FILTER_FIELD="" to skip filtering entirely if
# your instance differs.
MONGO_URI=mongodb://vinyl_display_reader:your_password@UNRAID_IP:27017/dvinyl?authSource=dvinyl
MONGO_DB_NAME=dvinyl
MONGO_COLLECTION_NAME=albums
MONGO_FILTER_FIELD=kind
MONGO_FILTER_VALUE=Music

# Field names inside a DVinyl album document — verify against your own
# instance with: db.albums.findOne()
FIELD_ARTIST=artist
FIELD_TITLE=title
FIELD_FORMAT=media_type
FIELD_TRACKLIST=tracklist

# --- Display ---
# epd4in2_V2 confirmed as the correct driver module for this hardware
# revision (check yours: grep "^from waveshare_epd import" against your
# working Waveshare demo script if it differs).
DISPLAY_MODEL=epd4in2_V2
POLL_INTERVAL_SECONDS=25

# --- Silence detection ---
# RMS amplitude (roughly 0-1) above which a clip counts as "something is
# playing" rather than silence between records — also used to skip AudD
# calls and report "off" to Home Assistant when the turntable is idle.
SILENCE_THRESHOLD=0.02

# --- Home Assistant ---
# Optional — leave both blank to disable this feature entirely. Powers the
# "Now Playing Light" automation: turns light.now_playing_light on/off
# based on whether the turntable is actually playing.
# HA_TOKEN is a Long-Lived Access Token: create one in Home Assistant under
# your Profile page (scroll to "Long-lived access tokens" -> Create Token).
HA_URL=http://YOUR_HOME_ASSISTANT_IP:8123
HA_TOKEN=your_long_lived_access_token_here
HA_PLAYING_ENTITY_ID=binary_sensor.groove_tracker_playing
